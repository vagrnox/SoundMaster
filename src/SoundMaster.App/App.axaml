<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoundMaster.App.App"
             xmlns:local="using:SoundMaster.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="#0B0B0B" />
        </Style>

        <!-- Nút dạng viên thuốc trên thanh công cụ -->
        <Style Selector="Button.pill, ToggleButton.pill">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2C2C2C" />
        </Style>
        <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#171717" />
            <Setter Property="Foreground" Value="#555555" />
        </Style>

        <!-- Nút tròn nhỏ M / S / A trong sidebar -->
        <Style Selector="ToggleButton.mini">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#363636" />
        </Style>
        <Style Selector="ToggleButton.mini.mute:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8A2A2A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.mini.solo:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F5C542" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ToggleButton.mini.lock:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF9800" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ToggleButton.mini.arm:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Nút chấm màu -->
        <Style Selector="Button.dot">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.dot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#363636" />
        </Style>

        <!-- TextBox phẳng (tên track, tên bài hát) -->
        <Style Selector="TextBox.flat /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.flat:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1E1E" />
        </Style>
        <Style Selector="TextBox.flat:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#262626" />
        </Style>
    </Application.Styles>
</Application>
