<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundMaster.App.ViewModels"
             xmlns:ctl="using:SoundMaster.App.Controls"
             x:Class="SoundMaster.App.Views.SheetView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="44,*,Auto" Background="#0B0B0B">

        <!-- Thanh trên: quay lại, chọn track, xuất -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#4A4F57" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,0">
                <Button Grid.Column="0" Classes="pill" Padding="12,5" VerticalAlignment="Center"
                        Command="{Binding CloseSheetCommand}" ToolTip.Tip="Về piano roll (Esc)">
                    <TextBlock Text="←  Piano roll" FontSize="12" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button Classes="pill" Padding="10,4" Command="{Binding SheetPreviousTrackCommand}" ToolTip.Tip="Track trước">
                        <TextBlock Text="‹" FontSize="14" />
                    </Button>
                    <TextBlock Text="{Binding SelectedTrack.Name}" FontSize="13" FontWeight="SemiBold" MinWidth="120"
                               TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Classes="pill" Padding="10,4" Command="{Binding SheetNextTrackCommand}" ToolTip.Tip="Track sau">
                        <TextBlock Text="›" FontSize="14" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="pill" Padding="12,5" Click="OnSavePng" IsEnabled="{Binding SelectedTrack.HasNotes}"
                            ToolTip.Tip="Lưu bản nhạc thành ảnh PNG">
                        <TextBlock Text="Lưu ảnh PNG…" FontSize="12" />
                    </Button>
                    <Button Classes="pill" Padding="12,5" Click="OnExportMidi" IsEnabled="{Binding SelectedTrack.HasNotes}"
                            ToolTip.Tip="Xuất MIDI (kèm lời)">
                        <TextBlock Text="Xuất MIDI…" FontSize="12" />
                    </Button>
                    <Button Classes="gold" Padding="12,5" Click="OnExportMusicXml" IsEnabled="{Binding SelectedTrack.HasNotes}"
                            ToolTip.Tip="Xuất MusicXML (mở bằng MuseScore, Finale, Sibelius…)">
                        <TextBlock Text="Xuất MusicXML…" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bản nhạc: giấy trắng ở giữa, cuộn dọc -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#222428">
            <Border MaxWidth="1180" HorizontalAlignment="Stretch" Margin="16,16,16,16" BoxShadow="0 4 24 0 #80000000">
                <ctl:SheetMusicView x:Name="Sheet" Score="{Binding SheetScore}"
                                    Title="{Binding SelectedTrack.Name}"
                                    PositionSeconds="{Binding Timeline.PositionSeconds}" />
            </Border>
        </ScrollViewer>

        <!-- Dòng nhập lời -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="Lời bài hát" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding LyricsInfo}" FontSize="11" Opacity="0.65"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8">
                    <TextBox Classes="flat" Text="{Binding SelectedTrack.Lyrics, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="130" Padding="12,8"
                             FontSize="14"
                             PlaceholderText="Gõ lời ở đây: mỗi âm tiết ứng một nốt, cách nhau bằng dấu cách. Dùng - để tách âm tiết trong một từ (ba-by), _ để bỏ qua một nốt." />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
