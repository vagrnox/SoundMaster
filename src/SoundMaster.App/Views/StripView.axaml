<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundMaster.App.ViewModels"
             xmlns:ctl="using:SoundMaster.App.Controls"
             x:Class="SoundMaster.App.Views.StripView"
             x:DataType="vm:StripViewModel">
    <Border Width="96" Margin="3" Padding="8" CornerRadius="6"
            Background="#22262E" BorderBrush="#333944" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                       ToolTip.Tip="{Binding Name}" />
            <TextBlock Grid.Row="1" Text="PAN" FontSize="9" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <Slider Grid.Row="2" x:Name="PanSlider" Minimum="-1" Maximum="1"
                    Value="{Binding Pan}" DoubleTapped="OnPanDoubleTapped"
                    ToolTip.Tip="Double-click để về giữa" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6">
                <Slider Grid.Column="0" x:Name="FaderSlider" Orientation="Vertical"
                        Minimum="-60" Maximum="6" Value="{Binding GainDb}"
                        HorizontalAlignment="Center" MinHeight="140"
                        DoubleTapped="OnFaderDoubleTapped"
                        ToolTip.Tip="Double-click để về 0 dB" />
                <ctl:LevelMeter Grid.Column="1" Width="18" Margin="4,4,0,4"
                                LeftDb="{Binding MeterLeftDb}" RightDb="{Binding MeterRightDb}" />
            </Grid>
            <TextBlock Grid.Row="4" Text="{Binding GainText}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,6" />
            <UniformGrid Grid.Row="5" Columns="2">
                <ToggleButton Content="M" IsChecked="{Binding IsMuted}" Margin="0,0,2,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <ToggleButton Content="S" IsChecked="{Binding IsSolo}" Margin="2,0,0,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
