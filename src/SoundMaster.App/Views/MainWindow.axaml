<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SoundMaster.App.ViewModels"
        xmlns:views="using:SoundMaster.App.Views"
        xmlns:ctl="using:SoundMaster.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="560"
        x:Class="SoundMaster.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SoundMaster — Mixer"
        Width="1100" Height="600" MinWidth="720" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Space" Command="{Binding PlayPauseCommand}" />
    </Window.KeyBindings>

    <DockPanel Margin="10">

        <!-- Thanh trạng thái -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,4" CornerRadius="4" Background="#1A1D23">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="80" Height="6"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <!-- Thanh công cụ + transport -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <WrapPanel>
                <Button Content="📂 Mở thư mục stems…" Click="OnOpenFolder" Margin="0,0,6,6" IsEnabled="{Binding !IsBusy}" />
                <Button Content="➕ Thêm file…" Click="OnAddFiles" Margin="0,0,6,6" IsEnabled="{Binding !IsBusy}" />
                <Button Content="🎹 Stem demo" Command="{Binding LoadDemoCommand}" Margin="0,0,6,6" IsEnabled="{Binding !IsBusy}" />
                <Button Content="🗑 Xóa hết" Command="{Binding ClearCommand}" Margin="0,0,16,6" IsEnabled="{Binding !IsBusy}" />
                <Button Content="💾 Xuất WAV…" Click="OnExport" Margin="0,0,6,6" IsEnabled="{Binding !IsBusy}" />
                <ComboBox x:Name="FormatBox" SelectedIndex="1" Margin="0,0,6,6" Width="110">
                    <ComboBoxItem Content="16-bit" />
                    <ComboBoxItem Content="24-bit" />
                    <ComboBoxItem Content="32-bit float" />
                </ComboBox>
            </WrapPanel>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}"
                        MinWidth="90" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="⏹ Stop" Command="{Binding StopCommand}" Margin="0,0,10,0" />
                <Slider Grid.Column="2" Minimum="0" Maximum="{Binding SeekMaximum}"
                        Value="{Binding PositionSeconds}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding TimeText}" VerticalAlignment="Center"
                           Margin="10,0" FontFamily="Consolas,monospace" />
                <ToggleButton Grid.Column="4" Content="🔁 Loop" IsChecked="{Binding LoopEnabled}" />
            </Grid>
        </StackPanel>

        <!-- Master bus -->
        <Border DockPanel.Dock="Right" Width="120" Margin="6,3,3,3" Padding="8" CornerRadius="6"
                Background="#2A2F3A" BorderBrush="#4A5266" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,6">
                    <Slider x:Name="MasterFader" Orientation="Vertical" Minimum="-60" Maximum="6"
                            Value="{Binding MasterGainDb}" HorizontalAlignment="Center" MinHeight="140"
                            DoubleTapped="OnMasterDoubleTapped" ToolTip.Tip="Double-click để về 0 dB" />
                    <ctl:LevelMeter Grid.Column="1" Width="26" Margin="4,4,0,4"
                                    LeftDb="{Binding MasterMeterLeftDb}" RightDb="{Binding MasterMeterRightDb}" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding MasterGainText}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <ToggleButton Grid.Row="3" Content="Limiter" IsChecked="{Binding LimiterEnabled}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <TextBlock Grid.Row="4" Text="{Binding LimiterReductionDb, StringFormat='GR {0:0.0} dB'}"
                           FontSize="10" Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- Các kênh -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Strips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StripViewModel">
                        <views:StripView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
