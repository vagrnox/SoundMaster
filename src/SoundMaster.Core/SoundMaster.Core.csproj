<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Xuất ra loa dùng WinMM nên hiện chỉ chạy Windows; AudioOutput có [SupportedOSPlatform("windows")]. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

</Project>
